# Database
DATABASE_URL="file:./dev.db"

# JWT Secret - generate using: openssl rand -base64 32
JWT_SECRET=""

# Pusher - get from https://dashboard.pusher.com/
# Server-side (keep secret)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"

# Client-side (safe to expose)
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# Email (password reset, welcome, deposit decisions). Leave SMTP_HOST unset in
# development and emails are printed to the server console instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"            # "true" for port 465
MAIL_FROM="AlphaReserve <no-reply@example.com>"
# Public origin used in emailed links
APP_URL="http://localhost:3000"
# Optional: receives a notice for every new deposit request
ADMIN_EMAIL=""
